{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retailer-insights-testing/schemas/purchase-order.fixture.schema.json",
  "title": "Walmart purchase order fixture",
  "type": "object",
  "required": ["_meta", "purchaseOrderNumber", "storeId", "orderDate", "mustArriveByDate", "status", "lines"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["fixtureId", "expectation"],
      "properties": {
        "fixtureId": { "type": "string" },
        "expectation": { "enum": ["pass", "fail"] },
        "expectedRuleFailures": {
          "type": "array",
          "items": { "type": "string", "pattern": "^PO-[0-9]{3}$" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "purchaseOrderNumber": { "type": "string" },
    "storeId": { "type": "string" },
    "orderDate": { "type": "string", "format": "date" },
    "mustArriveByDate": { "type": "string", "format": "date" },
    "status": { "enum": ["Active", "Closed", "Cancelled"] },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lineNumber", "itemNumber", "orderedQuantity", "openQuantity"],
        "properties": {
          "lineNumber": { "type": "integer", "minimum": 1 },
          "itemNumber": { "type": "string" },
          "orderedQuantity": { "type": "number", "minimum": 0 },
          "openQuantity": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
